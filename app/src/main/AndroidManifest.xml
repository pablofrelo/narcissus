<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pozycja. COARSE jest wymagane obok FINE od API 31. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Ciągły zapis śladu przy zgaszonym ekranie. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Czujnik kroków dla trybów pieszych. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Synchronizacja z heimdallem. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Uwaga: siła sygnału GSM przez TelephonyCallback.SignalStrengthsListener
        NIE wymaga READ_PHONE_STATE. Nie dodawaj tego uprawnienia, dopóki
        nie okaże się, że na Twoim urządzeniu naprawdę jest potrzebne.
    -->

    <uses-feature android:name="android.hardware.location.gps" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <application
        android:name=".NarcissusApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Narcissus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Narcissus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
