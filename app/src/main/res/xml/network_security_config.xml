<?xml version="1.0" encoding="utf-8"?>
<!--
    Jedyne połączenie sieciowe aplikacji to serwer synchronizacji, którego
    adres wpisuje użytkownik. Serwer zwykle stoi w sieci prywatnej
    (WireGuard, LAN) na gołym HTTP — tunel sam szyfruje transport — więc
    ruch nieszyfrowany jest dozwolony. Adresu nie da się znać z góry,
    a Android nie pozwala tu wpisać zakresu adresów prywatnych.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
